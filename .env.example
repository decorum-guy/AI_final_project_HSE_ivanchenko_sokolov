BOT_TOKEN=
BOT_USE_PROXY=false
BOT_PROXY_URL=
OPENAI_API_KEY=
# Official OpenAI uses models without prefix. For OpenRouter use openai/ prefix and:
# AI_PROVIDER=chatgpt
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1_your_key_here
# OPENAI_MODEL=openai/gpt-5.4
# OPENAI_FALLBACK_MODEL=openai/gpt-5.4-mini
# OPENAI_NANO_MODEL=openai/gpt-5.4-nano
OPENAI_MODEL=gpt-5.4
OPENAI_FALLBACK_MODEL=gpt-5.4-mini
OPENAI_NANO_MODEL=gpt-5.4-nano
OPENAI_DAILY_TOKEN_LIMIT=200000
OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
DATABASE_URL=sqlite+aiosqlite:///./bot.db
ADMIN_ID=
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://127.0.0.1:8080
